{
  "name": "crypto-staked-basis-engine",
  "version": "1.0.0",
  "description": "Institutional Quantitative Simulation, Risk Modeling & Backtesting Engine for Crypto Staked Basis Trades",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "build": "esbuild src/app.js --bundle --outfile=dist/bundle.js --format=iife",
    "dev": "esbuild src/app.js --bundle --outfile=dist/bundle.js --format=iife --watch",
    "start": "npx serve ."
  },
  "keywords": [
    "crypto",
    "hedging",
    "delta-neutral",
    "liquidation",
    "cross-margin",
    "isolated-margin",
    "staked-basis"
  ],
  "author": "NoobChester",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
